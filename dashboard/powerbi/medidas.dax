// =============================================================================
// Medidas DAX del informe (tabla _Medidas del modelo semántico)
// Modelo: fct_demanda (hechos) -> dim_comida, dim_centro, dim_semana
// Copia legible de dashboard_demanda.SemanticModel/definition/tables/_Medidas.tmdl
// =============================================================================

Pedidos =
SUM ( fct_demanda[pedidos] )

Filas =
COUNTROWS ( fct_demanda )

Precio promedio fila =
AVERAGE ( fct_demanda[precio_checkout] )

Control pedidos totales =
IF ( CALCULATE ( [Pedidos], REMOVEFILTERS () ) = 119557485, "OK", "Revisar" )

Control filas =
IF ( CALCULATE ( [Filas], REMOVEFILTERS () ) = 456548, "OK", "Revisar" )

Ingreso estimado =
SUM ( fct_demanda[ingreso_estimado] )

Precio promedio ponderado =
DIVIDE ( [Ingreso estimado], [Pedidos] )

Pedidos por fila =
DIVIDE ( [Pedidos], [Filas] )

Centros activos =
DISTINCTCOUNT ( fct_demanda[center_id] )

Comidas activas =
DISTINCTCOUNT ( fct_demanda[meal_id] )

Media móvil 4 semanas =
VAR s = SELECTEDVALUE ( dim_semana[semana] )
VAR ventana =
    CALCULATETABLE (
        VALUES ( dim_semana[semana] ),
        REMOVEFILTERS ( dim_semana ),
        dim_semana[semana] > s - 4,
        dim_semana[semana] <= s
    )
VAR semanasConDatos =
    CALCULATE ( DISTINCTCOUNT ( fct_demanda[semana] ), REMOVEFILTERS ( dim_semana ), ventana )
RETURN
    IF (
        NOT ISBLANK ( s ) && semanasConDatos = 4,
        CALCULATE ( [Pedidos], REMOVEFILTERS ( dim_semana ), ventana ) / 4
    )

Participación pedidos =
DIVIDE (
    [Pedidos],
    CALCULATE ( [Pedidos], ALLSELECTED ( dim_comida ), ALLSELECTED ( dim_centro ) )
)

Ranking categoría =
IF (
    HASONEVALUE ( dim_comida[categoria] ),
    RANKX ( ALLSELECTED ( dim_comida[categoria] ), [Pedidos], , DESC, DENSE )
)

Ranking centro =
IF ( HASONEVALUE ( dim_centro[center_id] ), RANKX ( ALLSELECTED ( dim_centro ), [Pedidos], , DESC, SKIP ) )

Tasa de retención =
DIVIDE ( SUM ( mart_cohortes[pares_activos] ), SUM ( mart_cohortes[pares_observables] ) )
